
# =========================================================
# CMMS Enterprise — Environment Example
# =========================================================

CMMS_ENV=development

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Control database
POSTGRES_CONTROL_DB=cmms_control
POSTGRES_CONTROL_USER=cmms_user
POSTGRES_CONTROL_PASSWORD=cmms_password
POSTGRES_CONTROL_HOST=localhost
POSTGRES_CONTROL_PORT=5432

# Client template database
POSTGRES_CLIENT_TEMPLATE_DB=cmms_client_template
POSTGRES_CLIENT_TEMPLATE_USER=cmms_user
POSTGRES_CLIENT_TEMPLATE_PASSWORD=cmms_password
POSTGRES_CLIENT_TEMPLATE_HOST=localhost
POSTGRES_CLIENT_TEMPLATE_PORT=5433

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
